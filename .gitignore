# ============================================================================
# MIND — Mageepan's Intelligence Network Device (.gitignore)
# Strict Credential, Database, Cache, and Runtime Artifact Exclusions
# ============================================================================

# 1. Environment & Secret Files (NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key
*secret*
*credentials*
glm_config.json
sentinel_hashes.json
session_log.json

# 2. Databases & Persistent User Memory
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
assets/
Workspace/
osint_reports/
cache/
models/

# 3. Generated Studio Workspace Outputs & Evidence Captures
MIND_GameDev/workspace/*
!MIND_GameDev/workspace/.gitkeep
MIND_GameDev/MIND_EVIDENCE/
temp_input.wav
*.wav

# 4. Python Bytecode, Caches, and Virtual Environments
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/
mind_env/
mind_env_312/

# 5. Test & Coverage Caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# 6. IDE & OS Metadata
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store
*.log
