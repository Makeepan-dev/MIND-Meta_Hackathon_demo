# ============================================================================
# MIND — Mageepan's Intelligence Network Device
# Meta Global AI Developer Hackathon Edition | Environment Configuration
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env` in the repository root:
#      Copy-Item .env.example .env
# 2. Replace the placeholder values below with your own API keys.
# 3. NEVER commit your `.env` file to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. PRIMARY AI ENGINE — Official Meta AI Model API (Required for Cloud Brains)
# ----------------------------------------------------------------------------
# Obtain your API key from the Meta AI Developer Portal (https://llama.developer.meta.com)
# or your Meta Global AI Developer Hackathon Model API credits dashboard.
MODEL_API_KEY=your_meta_model_api_key_here
META_API_KEY=your_meta_model_api_key_here
META_API_BASE=https://api.meta.ai/v1

# Meta AI Model Assignments per Specialist Brain Role
META_CODING_MODEL=muse-spark-1.3
META_REASONING_MODEL=muse-wonder-1.0
META_ANALYSIS_MODEL=muse-spark-1.2
META_FAST_MODEL=muse-spark-1.1

# ----------------------------------------------------------------------------
# 2. UI/UX & WEBSITE DESIGN GENERATION — Google Stitch MCP (Required for Live Stitch)
# ----------------------------------------------------------------------------
# Used exclusively for live UI/UX design and interactive HTML/CSS screen generation
# inside MIND's dedicated Design Preview Popup Window.
STITCH_API_KEY=your_google_stitch_api_key_here
STITCH_MCP_URL=https://stitch.googleapis.com/mcp
STITCH_CONNECT_TIMEOUT=15
STITCH_GENERATE_TIMEOUT=180
STITCH_FOLLOWUP_TIMEOUT=30
STITCH_DOWNLOAD_TIMEOUT=30

# ----------------------------------------------------------------------------
# 3. LOCAL OFFLINE FALLBACK — Ollama (Optional)
# ----------------------------------------------------------------------------
# Install Ollama from https://ollama.com and pull local models if you want
# zero-cost offline inference or local fallback:
#   ollama pull llama3.2:1b
#   ollama pull qwen2.5-coder:7b
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_META_MODEL=llama3.2:1b
OLLAMA_CODING_MODEL=qwen2.5-coder:7b

# ----------------------------------------------------------------------------
# 4. OPTIONAL 2D / 3D ASSET GENERATION PROVIDERS
# ----------------------------------------------------------------------------
# When unset, MIND automatically uses its built-in local Pillow 2D renderer
# and procedural Wavefront OBJ / GLB 3D mesh generator.
AI_HORDE_API_KEY=0000000000
IMAGE_GEN_API_KEY=your_optional_image_api_key_here
STABILITY_API_KEY=your_optional_stability_api_key_here
TRIPO_API_KEY=your_optional_tripo3d_api_key_here
BLENDER_EXECUTABLE=blender

# ----------------------------------------------------------------------------
# 5. RUNTIME & VOICE SETTINGS
# ----------------------------------------------------------------------------
MIND_VOICE_OUTPUT=1
MIND_VOICE_INPUT=0
MIND_TEST_MODE=0
